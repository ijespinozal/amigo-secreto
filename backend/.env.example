# Copia este archivo como .env y completa los valores.
# En Render se configuran en Dashboard > Environment (no se sube ningún .env).

# development | production
NODE_ENV=development
PORT=5000

# ---- Base de datos ----
# Opción A: URL completa (formato habitual de proveedores cloud). Tiene prioridad.
# DB_URL=mysql://usuario:password@host:3306/amigo_secreto_db
# Opción B: variables individuales (XAMPP local).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=amigo_secreto_db
DB_USER=root
DB_PASSWORD=
# true para proveedores cloud que exigen TLS (Aiven, TiDB, PlanetScale, Railway público...)
DB_SSL=false
# Certificado CA en PEM si el proveedor lo exige (Aiven). Se puede pegar en una
# sola línea usando \n como salto de línea.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_LOGGING=false

# ---- Autenticación ----
# Obligatorio. En producción mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Orígenes del frontend permitidos, separados por coma. Obligatorio en producción.
CORS_ORIGIN=http://localhost:5173

# ---- Bootstrap del administrador (opcional) ----
# Si están definidas, `npm run start:prod` crea el admin cuando no existe.
# Nunca sobrescribe la contraseña de una cuenta existente.
# ADMIN_PHONE=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=
